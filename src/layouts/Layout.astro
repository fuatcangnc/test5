---
import PageSeo from "../components/wuppy/PageSeo.astro";
import PageCode from "../components/wuppy/PageCode.astro";
import { pageSettings as wuppyPageSettings } from "../components/wuppy/page-settings";
import '@/styles/globals.css'
import { Font } from 'astro:assets'
import { SEO } from 'astro-seo'
import SiteHeader from '@/components/SiteHeader.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import FloatingWhatsApp from '@/components/FloatingWhatsApp.astro'
import WuppycmsBridge from '@/components/WuppycmsBridge.astro'
import Hreflang from '@/components/i18n/Hreflang.astro'
import { tag } from '@/components/i18n/languages'
import { dir, settings, siteText } from '@/lib/i18n'

interface Props {
  locale: string
  title?: string
  description?: string
  /** Locales this page exists in (language switcher and hreflang). */
  translated?: string[]
}

const { locale, translated } = Astro.props
const s = await settings()
const t = await siteText(locale)
const rawTitle = Astro.props.title && Astro.props.title !== s.brand ? `${Astro.props.title} | ${s.brand}` : s.brand
const rawDescription = Astro.props.description ?? t.hero.text
const title = rawTitle.length > 60 ? `${rawTitle.slice(0, 57).trimEnd()}...` : rawTitle
const description = rawDescription.length > 155 ? `${rawDescription.slice(0, 152).trimEnd()}...` : rawDescription
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
const wuppySearchExcluded = (await wuppyPageSettings(Astro.routePattern, Astro.currentLocale)).search?.exclude
---

<!doctype html>
<html lang={tag(locale)} dir={dir(locale)}>
  <head>
    <meta charset="UTF-8" />
    <Font cssVariable="--font-sans" preload />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#121820" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: { title, type: 'website', image: new URL('/og-image.png', Astro.site ?? Astro.url.origin).href, url: canonical },
        optional: { description, locale: tag(locale).replace('-', '_'), siteName: s.brand },
        image: { alt: title },
      }}
      twitter={{ card: 'summary_large_image', title, description }}
      robotsExtras="max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Hreflang translated={translated} />
    <PageSeo />
  </head>
  <body data-pagefind-ignore={wuppySearchExcluded ? 'all' : undefined} class="font-sans">
    <SiteHeader locale={locale} translated={translated} />
    <slot />
    <SiteFooter locale={locale} />
    <FloatingWhatsApp locale={locale} />
    <WuppycmsBridge />
    <script is:inline>
      const loadInit = () => import('/scripts/motion-init.js')
      window.addEventListener('scroll', loadInit, { once: true, passive: true })
      window.addEventListener('pointerdown', loadInit, { once: true })
      window.addEventListener('keydown', loadInit, { once: true })
    </script>
    <PageCode />
  </body>
</html>
